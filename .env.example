# Copy to .env (never commit the real one).
# Enables Claude-picked moments, written hooks and platform captions.
ANTHROPIC_API_KEY=
# Model used for highlight detection
CLIPVIRAL_CLAUDE_MODEL=claude-opus-5-5
# faster-whisper model: tiny | base | small | medium | large-v3
CLIPVIRAL_WHISPER_MODEL=base
CLIPVIRAL_WHISPER_DEVICE=auto
# Optional: path to OpenCV's face_detection_yunet_2023mar.onnx for stronger face tracking
CLIPVIRAL_FACE_MODEL=
# Where uploads and renders are stored
CLIPVIRAL_DATA=./data
CLIPVIRAL_WORKERS=1
CLIPVIRAL_MAX_UPLOAD_GB=8
# Optional: free Pexels API key (https://www.pexels.com/api/) for AI B-roll cutaways
PEXELS_API_KEY=
# Public address of the site, used in Stripe redirects and invite links
CLIPVIRAL_PUBLIC_URL=http://localhost:8000
# Set to 1 when serving over HTTPS so login cookies are marked Secure
CLIPVIRAL_SECURE_COOKIES=0
# Stripe billing (dashboard: Products -> add three monthly GBP prices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
